{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "create-react-app"
    },
    "api": {
      "entrypoint": "backend/server.js",
      "routePrefix": "/api",
      "framework": "express",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "20 6 * * *"
    }
  ]
}
